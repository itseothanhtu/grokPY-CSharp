<UserControl x:Class="GrokPY.App.Views.Tabs.TabCreateImage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <TextBlock Text="🎨 Tạo ảnh"
                           Style="{StaticResource SectionTitle}"
                           FontSize="16" Margin="0,0,0,16"/>

                <!-- Model -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="MODEL" Style="{StaticResource SectionTitle}"/>
                        <ComboBox x:Name="CmbModel">
                            <ComboBoxItem Content="Imagen 4" IsSelected="True"/>
                            <ComboBoxItem Content="Nano Banana"/>
                            <ComboBoxItem Content="Nano Banana 2"/>
                            <ComboBoxItem Content="Nano Banana Pro"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Prompt -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="PROMPT" Style="{StaticResource SectionTitle}"/>
                        <TextBox x:Name="TxtPrompt" Height="100"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                />
                        <CheckBox x:Name="ChkBatch"
                                  Content="Batch mode (mỗi dòng = 1 ảnh)"
                                  Foreground="{StaticResource MutedBrush}"
                                  Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Config -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Tỷ lệ" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbAspect">
                                <ComboBoxItem Content="9:16" IsSelected="True"/>
                                <ComboBoxItem Content="16:9"/>
                                <ComboBoxItem Content="1:1"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Số lượng" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbCount">
                                <ComboBoxItem Content="1" IsSelected="True"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="4"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Seed" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtSeed" Text="-1"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button x:Name="BtnCreate" Content="🎨 Tạo ảnh"
                            Style="{StaticResource PrimaryButton}"
                            Padding="20,10" FontSize="14"
                            Margin="0,0,8,0"
                            Click="BtnCreate_Click"/>
                    <Button x:Name="BtnStop" Content="⏹️ Dừng"
                            Style="{StaticResource SecondaryButton}"
                            Padding="16,10" IsEnabled="False"
                            Click="BtnStop_Click"/>
                </StackPanel>

                <ProgressBar x:Name="PbProgress" Height="8"
                             Margin="0,0,0,8" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtStatus"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Right: Output -->
        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <StackPanel>
                <Border BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="12,8">
                    <TextBlock Text="🖼️ Ảnh đã tạo"
                               Style="{StaticResource SectionTitle}" Margin="0"/>
                </Border>
                <ListBox x:Name="LstOutput" Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource TextBrush}"
                         FontSize="11" Margin="4"/>
                <Button Content="📂 Mở thư mục"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8" Padding="8,6" FontSize="11"
                        Click="BtnOpenFolder_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
