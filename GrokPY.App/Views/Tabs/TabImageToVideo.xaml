<UserControl x:Class="GrokPY.App.Views.Tabs.TabImageToVideo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <TextBlock Text="🖼️ Image → Video"
                           Style="{StaticResource SectionTitle}"
                           FontSize="16" Margin="0,0,0,16"/>

                <!-- Engine -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ENGINE" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbVeo" Content="🌐 Google Veo 3.1"
                                         IsChecked="True"
                                         Foreground="{StaticResource TextBrush}"
                                         Margin="0,0,16,0"/>
                            <RadioButton x:Name="RbGrok" Content="🤖 Grok"
                                         Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Chọn ảnh -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ẢNH ĐẦU VÀO" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtImagePath"
                                     IsReadOnly="True"
                                    
                                     Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="📂 Chọn ảnh"
                                    x:Name="BtnBrowseImage"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="10,8"
                                    Click="BtnBrowseImage_Click"/>
                        </Grid>

                        <!-- Preview ảnh -->
                        <Border x:Name="ImgPreviewBorder"
                                Margin="0,8,0,0" Height="160"
                                Background="#11ffffff"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Visibility="Collapsed">
                            <Image x:Name="ImgPreview"
                                   Stretch="Uniform" Margin="4"/>
                        </Border>

                        <!-- Batch mode -->
                        <CheckBox x:Name="ChkBatch"
                                  Content="Batch mode (chọn nhiều ảnh)"
                                  Foreground="{StaticResource MutedBrush}"
                                  Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Prompt -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="PROMPT (tuỳ chọn)"
                                   Style="{StaticResource SectionTitle}"/>
                        <TextBox x:Name="TxtPrompt" Height="80"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                />
                    </StackPanel>
                </Border>

                <!-- Config -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Tỷ lệ" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbAspect">
                                <ComboBoxItem Content="9:16 (Portrait)" IsSelected="True"/>
                                <ComboBoxItem Content="16:9 (Landscape)"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Độ dài (giây)" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbDuration">
                                <ComboBoxItem Content="5"/>
                                <ComboBoxItem Content="6" IsSelected="True"/>
                                <ComboBoxItem Content="8"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button x:Name="BtnGenerate" Content="▶️ Tạo Video"
                            Style="{StaticResource PrimaryButton}"
                            Padding="20,10" FontSize="14"
                            Margin="0,0,8,0"
                            Click="BtnGenerate_Click"/>
                    <Button x:Name="BtnStop" Content="⏹️ Dừng"
                            Style="{StaticResource SecondaryButton}"
                            Padding="16,10" IsEnabled="False"
                            Click="BtnStop_Click"/>
                </StackPanel>

                <ProgressBar x:Name="PbProgress" Height="8"
                             Margin="0,0,0,8" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtStatus"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Right: Output -->
        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <StackPanel>
                <Border BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="12,8">
                    <TextBlock Text="📁 Output"
                               Style="{StaticResource SectionTitle}" Margin="0"/>
                </Border>
                <ListBox x:Name="LstOutput" Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource TextBrush}"
                         FontSize="11" Margin="4"/>
                <Button Content="📂 Mở thư mục"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8" Padding="8,6" FontSize="11"
                        Click="BtnOpenFolder_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
