<UserControl x:Class="GrokPY.App.Views.Tabs.TabIdeaToVideo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="240"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <TextBlock Text="💡 Idea → Video"
                           Style="{StaticResource SectionTitle}"
                           FontSize="16" Margin="0,0,0,4"/>
                <TextBlock Text="Nhập ý tưởng ngắn → AI tự tạo prompt → ảnh → video"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11" Margin="0,0,0,16"/>

                <!-- Ý tưởng -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Ý TƯỞNG" Style="{StaticResource SectionTitle}"/>
                        <TextBox x:Name="TxtIdea" Height="80"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                />
                    </StackPanel>
                </Border>

                <!-- Config -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="CÀI ĐẶT" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Số cảnh" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbSceneCount">
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="3" IsSelected="True"/>
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="7"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Engine video" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbEngine">
                                    <ComboBoxItem Content="Veo 3.1" IsSelected="True"/>
                                    <ComboBoxItem Content="Grok"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tỷ lệ" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbAspect">
                                    <ComboBoxItem Content="9:16" IsSelected="True"/>
                                    <ComboBoxItem Content="16:9"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="ChkMerge"
                                  Content="Ghép tất cả video thành 1 file cuối"
                                  IsChecked="True"
                                  Foreground="{StaticResource TextBrush}"
                                  Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Pipeline status -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="TIẾN ĐỘ PIPELINE"
                                   Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Step 1 -->
                            <Border x:Name="Step1Border" Grid.Column="0"
                                    Background="#11ffffff" CornerRadius="4"
                                    Padding="8,6" Margin="0,0,4,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="1️⃣" FontSize="18"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Sinh Prompt"
                                               FontSize="10" TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Step 2 -->
                            <Border x:Name="Step2Border" Grid.Column="1"
                                    Background="#11ffffff" CornerRadius="4"
                                    Padding="8,6" Margin="0,0,4,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="2️⃣" FontSize="18"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Tạo Ảnh"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Step 3 -->
                            <Border x:Name="Step3Border" Grid.Column="2"
                                    Background="#11ffffff" CornerRadius="4"
                                    Padding="8,6" Margin="0,0,4,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="3️⃣" FontSize="18"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Tạo Video"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Step 4 -->
                            <Border x:Name="Step4Border" Grid.Column="3"
                                    Background="#11ffffff" CornerRadius="4"
                                    Padding="8,6">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="4️⃣" FontSize="18"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Ghép Video"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button x:Name="BtnRun" Content="🚀 Chạy Pipeline"
                            Style="{StaticResource PrimaryButton}"
                            Padding="20,10" FontSize="14"
                            Margin="0,0,8,0"
                            Click="BtnRun_Click"/>
                    <Button x:Name="BtnStop" Content="⏹️ Dừng"
                            Style="{StaticResource SecondaryButton}"
                            Padding="16,10" IsEnabled="False"
                            Click="BtnStop_Click"/>
                </StackPanel>

                <ProgressBar x:Name="PbProgress" Height="8"
                             Margin="0,0,0,8" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtStatus"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Right: Log -->
        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <StackPanel>
                <Border BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="12,8">
                    <TextBlock Text="📋 Log"
                               Style="{StaticResource SectionTitle}" Margin="0"/>
                </Border>
                <ScrollViewer x:Name="LogScroller" Height="400"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtLog" Padding="8"
                               FontFamily="Consolas" FontSize="10"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
                <Button Content="📂 Mở output"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8" Padding="8,6" FontSize="11"
                        Click="BtnOpenFolder_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
