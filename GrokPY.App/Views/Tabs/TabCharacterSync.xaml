<UserControl x:Class="GrokPY.App.Views.Tabs.TabCharacterSync"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="700">
            <TextBlock Text="👤 Sync nhân vật (Lip Sync)"
                       Style="{StaticResource SectionTitle}"
                       FontSize="16" Margin="0,0,0,4"/>
            <TextBlock Text="Đồng bộ môi nhân vật trong video với audio"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="11" Margin="0,0,0,16"/>

            <!-- Video đầu vào -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6"
                    Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="VIDEO ĐẦU VÀO"
                               Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Video có nhân vật cần sync"
                               Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtVideoPath" IsReadOnly="True"
                                
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="📂 Chọn video"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,8"
                                Click="BtnBrowseVideo_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Audio đầu vào -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6"
                    Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="AUDIO ĐẦU VÀO"
                               Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="File audio muốn sync (mp3, wav, m4a)"
                               Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtAudioPath" IsReadOnly="True"
                                
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="🎵 Chọn audio"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,8"
                                Click="BtnBrowseAudio_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="BtnSync" Content="🎭 Bắt đầu Sync"
                        Style="{StaticResource PrimaryButton}"
                        Padding="20,10" FontSize="14"
                        Margin="0,0,8,0"
                        Click="BtnSync_Click"/>
                <Button x:Name="BtnStop" Content="⏹️ Dừng"
                        Style="{StaticResource SecondaryButton}"
                        Padding="16,10" IsEnabled="False"
                        Click="BtnStop_Click"/>
                <Button x:Name="BtnOpenOutput" Content="📂 Mở output"
                        Style="{StaticResource SecondaryButton}"
                        Padding="16,10" Margin="8,0,0,0"
                        Click="BtnOpenOutput_Click"/>
            </StackPanel>

            <ProgressBar x:Name="PbProgress" Height="8"
                         Margin="0,0,0,8" Visibility="Collapsed"/>
            <TextBlock x:Name="TxtStatus"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="12" TextWrapping="Wrap"/>

            <!-- Output -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6"
                    Padding="16" Margin="0,12,0,0"
                    Visibility="{Binding Visibility, ElementName=LstOutput}">
                <StackPanel>
                    <TextBlock Text="📁 Kết quả"
                               Style="{StaticResource SectionTitle}"/>
                    <ListBox x:Name="LstOutput" Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextBrush}"
                             FontSize="12" MaxHeight="150"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
