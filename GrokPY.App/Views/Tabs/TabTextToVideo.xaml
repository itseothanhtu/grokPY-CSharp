<UserControl x:Class="GrokPY.App.Views.Tabs.TabTextToVideo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <!-- ── LEFT: INPUT ── -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <TextBlock Text="📝 Text → Video"
                           Style="{StaticResource SectionTitle}" FontSize="16"
                           Margin="0,0,0,16"/>

                <!-- Engine chọn -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ENGINE" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbVeo" Content="🌐 Google Veo 3.1"
                                         IsChecked="True" Foreground="{StaticResource TextBrush}"
                                         Margin="0,0,16,0"/>
                            <RadioButton x:Name="RbGrok" Content="🤖 Grok"
                                         Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Prompt -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="PROMPT" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Mô tả video (tiếng Anh cho kết quả tốt hơn)"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtPrompt"
                                 Height="120" TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                />

                        <!-- Batch mode -->
                        <CheckBox x:Name="ChkBatch"
                                  Content="Chế độ Batch (mỗi dòng = 1 video)"
                                  Foreground="{StaticResource MutedBrush}"
                                  Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Config -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="CÀI ĐẶT" Style="{StaticResource SectionTitle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Tỷ lệ khung hình"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbAspectRatio">
                                    <ComboBoxItem Content="9:16 (Portrait)" IsSelected="True"/>
                                    <ComboBoxItem Content="16:9 (Landscape)"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Độ dài (giây)"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbDuration">
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="6" IsSelected="True"/>
                                    <ComboBoxItem Content="8"/>
                                    <ComboBoxItem Content="10"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button x:Name="BtnGenerate"
                            Content="▶️ Tạo Video"
                            Style="{StaticResource PrimaryButton}"
                            Padding="20,10" FontSize="14"
                            Margin="0,0,8,0"
                            Click="BtnGenerate_Click"/>
                    <Button x:Name="BtnStop"
                            Content="⏹️ Dừng"
                            Style="{StaticResource SecondaryButton}"
                            Padding="16,10"
                            IsEnabled="False"
                            Click="BtnStop_Click"/>
                </StackPanel>

                <!-- Progress -->
                <ProgressBar x:Name="PbProgress" Height="8" Margin="0,0,0,8"
                             Visibility="Collapsed"/>
                <TextBlock x:Name="TxtStatus"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ── RIGHT: OUTPUT ── -->
        <Border Grid.Column="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <StackPanel>
                <Border BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="12,8">
                    <TextBlock Text="📁 Output" Style="{StaticResource SectionTitle}"
                               Margin="0"/>
                </Border>
                <ListBox x:Name="LstOutput"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource TextBrush}"
                         FontSize="11"
                         Margin="4"/>
                <Button Content="📂 Mở thư mục"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8" Padding="8,6" FontSize="11"
                        Click="BtnOpenFolder_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
