<UserControl x:Class="GrokPY.App.Controls.StatusPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <TextBlock Text="📋 Log" Style="{StaticResource SectionTitle}" Margin="0"/>
                <Button Content="Xóa"
                        HorizontalAlignment="Right"
                        Style="{StaticResource SecondaryButton}"
                        Padding="8,4"
                        FontSize="11"
                        Click="ClearLog_Click"/>
            </Grid>
        </Border>

        <!-- Log text -->
        <ScrollViewer Grid.Row="1"
                      x:Name="LogScroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Background="{StaticResource BgBrush}">
            <TextBlock x:Name="LogTextBlock"
                       Padding="10"
                       FontFamily="Consolas"
                       FontSize="11"
                       Foreground="{StaticResource TextBrush}"
                       TextWrapping="Wrap"/>
        </ScrollViewer>

        <!-- Chrome status -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <StackPanel>
                <TextBlock Text="TRẠNG THÁI" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Ellipse x:Name="ChromeStatusDot"
                             Width="8" Height="8"
                             Fill="{StaticResource ErrorBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0"/>
                    <TextBlock x:Name="ChromeStatusText"
                               Text="Chrome: Chưa kết nối"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
